# Public configuration only. Never place secrets, service-role keys or
# private credentials here — anything prefixed VITE_ is shipped to the browser.

# Base URL of the future Node.js / Express API. Leave empty to use mock services.
VITE_API_BASE_URL=

# Supabase public (anon) configuration — for future client-side auth only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
