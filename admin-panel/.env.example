# Client-side values only. Everything prefixed VITE_ is bundled into the browser.
# Never put Supabase service-role keys, payment secrets or any other credential here.
VITE_API_BASE_URL=
VITE_APP_NAME=SlotPilot
# "true" = use in-browser mock services and simulated realtime updates.
VITE_USE_MOCKS=true
